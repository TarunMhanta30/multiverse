# Multiverse does not read this file. It lists the optional settings; set them in PowerShell before
# "python app.py", e.g.  $env:LLM_MODEL = "provider/model-name"
#
# Only needed for "Ask the graph" (Company page) and agent.py: any OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your-key
LLM_MODEL=provider/model-name
#
# Where FalkorDB runs (defaults shown).
FALKORDB_HOST=localhost
FALKORDB_PORT=6380